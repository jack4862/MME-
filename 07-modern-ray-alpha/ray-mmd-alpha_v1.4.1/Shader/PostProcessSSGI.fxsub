#define SSGI_SAMPLER_COUNT 64

#define SSGI_DEPTH_DIFF_MULTIPLIER 50

#if SSGI_QUALITY == 1
#   define SSGI_RAY_COUNT 1
#elif SSGI_QUALITY == 2
#   define SSGI_RAY_COUNT 2
#elif SSGI_QUALITY == 3
#   define SSGI_RAY_COUNT 4
#else
#   define SSGI_RAY_COUNT 1
#endif

static const float2 kSSGIBlur1QuadOffset = 2.0 / ViewportSize;
static const float2 kSSGIBlur2QuadOffset = 2 * kSSGIBlur1QuadOffset;
static const float2 kSSGIBlur3QuadOffset = 2 * kSSGIBlur2QuadOffset;
static const float2 kSSGIBlur4QuadOffset = 2 * kSSGIBlur3QuadOffset;
static const float2 kSSGIBlurFinalQuadOffset = kSSGIBlur4QuadOffset;

static const float2 kSSGIMaxLevelTexel = 2 * 2 * 2 * 2 / ViewportSize;

static const float2 SSGIScale = ViewportSize * 0.5;

static const float4 SSGIOffsetX1 = float4(1.3846153846 / ViewportSize.x, 0.0, 3.2307692308 / ViewportSize.x, 0.0);
static const float4 SSGIOffsetX2 = SSGIOffsetX1 * 2.0;
static const float4 SSGIOffsetX3 = SSGIOffsetX2 * 2.0;
static const float4 SSGIOffsetX4 = SSGIOffsetX3 * 2.0;

static const float4 SSGIOffsetY1 = float4(0.0, 2.0 * 1.3846153846 / ViewportSize.y, 0.0, 2.0 * 3.2307692308 / ViewportSize.y);
static const float4 SSGIOffsetY2 = SSGIOffsetY1 * 2.0;
static const float4 SSGIOffsetY3 = SSGIOffsetY2 * 2.0;
static const float4 SSGIOffsetY4 = SSGIOffsetY3 * 2.0;

texture SSGISampleMap : RENDERCOLORTARGET<float2 ViewportRatio = {1.0, 1.0}; string Format = "A16B16G16R16F";>;
sampler SSGISampleMapSamp = sampler_state {
    texture = <SSGISampleMap>;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
    MipFilter = NONE;
    AddressU = CLAMP; AddressV = CLAMP;
};

