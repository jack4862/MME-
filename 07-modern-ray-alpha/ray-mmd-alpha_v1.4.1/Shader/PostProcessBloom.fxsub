texture BloomMap : RENDERCOLORTARGET<float2 ViewportRatio={0.5, 0.5}; string Format="A16B16G16R16F";>;
sampler BloomMapSamp = sampler_state {
	texture = <BloomMap>;
	MinFilter = Linear; MagFilter = Linear; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

static float2 BloomBlurOffset1 = 4.0 / ViewportSize;
static float2 BloomBlurOffset2 = 8.0 / ViewportSize;
static float2 BloomBlurOffset3 = 16.0 / ViewportSize;
static float2 BloomBlurOffset4 = 32.0 / ViewportSize;

static float2 BloomBlurMip1TexelSize = 2.0 / ViewportSize;
static float2 BloomBlurMip2TexelSize = 4.0 / ViewportSize;
static float2 BloomBlurMip3TexelSize = 8.0 / ViewportSize;
static float2 BloomBlurMip4TexelSize = 16.0 / ViewportSize;
static float2 BloomBlurMip5TexelSize = 32.0 / ViewportSize;

static float2 BloomUpsampleOffset1 = 16.0 / ViewportSize;
static float2 BloomUpsampleOffset2 = 8.0 / ViewportSize;
static float2 BloomUpsampleOffset3 = 4.0 / ViewportSize;
static float2 BloomUpsampleOffset4 = 2.0 / ViewportSize;

float4 BloomDetectionPS(in float4 coord: TEXCOORD0, uniform sampler source) : COLOR
{
	float2 uv = coord.xy;
	float4 color = tex2Dlod(source, float4(uv, 0, 1));
	color = min(color, tex2Dlod(source, float4(uv + float2(+1.0, 0.0) * ViewportOffset2, 0, 1)));
	color = min(color, tex2Dlod(source, float4(uv + float2(-1.0, 0.0) * ViewportOffset2, 0, 1)));
	color = min(color, tex2Dlod(source, float4(uv + float2(0.0, +1.0) * ViewportOffset2, 0, 1)));
	color = min(color, tex2Dlod(source, float4(uv + float2(0.0, -1.0) * ViewportOffset2, 0, 1)));

	float4 MRT3 = tex2Dlod(Gbuffer3Map, float4(uv, 0, 0));
	float4 MRT4 = tex2Dlod(Gbuffer4Map, float4(uv, 0, 0));
	float4 MRT7 = tex2Dlod(Gbuffer7Map, float4(uv, 0, 0));
	float4 MRT8 = tex2Dlod(Gbuffer8Map, float4(uv, 0, 0));

	float3 emissive0 = DecodeGBufferEmissive(MRT3, MRT4);
	float3 emissive1 = DecodeGBufferEmissive(MRT7, MRT8);
	float alpha = frac(MRT8.w) / MAX_FRACTIONAL_8_BIT;

	color.rgb += max(0.0, lerp(emissive0, emissive1, alpha) * mBloomEmissiveMultiplier - 1.0);

	float depth = tex2Dlod(Gbuffer8Map, float4(uv, 0, 0)).r;
	float depth01 = saturate(depth / mBloomMaxDepth);
	float intensity = max(0, 1.0 - depth01 * mBloomDepthM);
	intensity *= min(1.0, depth01 / max(mBloomNearM, 1e-5));
	intensity *= CalculateLayer(LayerSamp, uv.xy, mBloomLayers);
	color.rgb *= intensity;

	return max(color, 0);
}

float4 BloomPrefilterVS(
	in float4 Position : POSITION,
	in float2 Texcoord : TEXCOORD,
	out float4 oTexcoord : TEXCOORD0
)  : POSITION
{
	oTexcoord.xy = Texcoord + 1.0 / ViewportSize;
	oTexcoord.zw = 1;
#if HDR_EYE_ADAPTATION == 1
	float aveLum = tex2Dlod(EyeLumAveMapSamp, float4(0.5,0.5,0,0)).r;
	oTexcoord.zw *= ComputeExposureISO(aveLum, 12.5);
#elif HDR_EYE_ADAPTATION == 2
	float aveLum = tex2Dlod(EyeLumAveMapSamp, float4(0.5,0.5,0,0)).r;
	oTexcoord.zw *= ComputeExposureISO(aveLum, 18.0);
#endif
	return Position;
}

float4 BloomPrefilterPS(in float4 coord: TEXCOORD0, uniform sampler source) : COLOR
{
	float2 uv = coord.xy;

	float texelSize = 1.0 / ViewportSize.x;
	float4 A = tex2Dlod(source, float4(uv + texelSize * float2(-1.0, -1.0), 0, 0));
	float4 B = tex2Dlod(source, float4(uv + texelSize * float2(0.0, -1.0), 0, 0));
	float4 C = tex2Dlod(source, float4(uv + texelSize * float2(1.0, -1.0), 0, 0));
	float4 D = tex2Dlod(source, float4(uv + texelSize * float2(-0.5, -0.5), 0, 0));
	float4 E = tex2Dlod(source, float4(uv + texelSize * float2(0.5, -0.5), 0, 0));
	float4 F = tex2Dlod(source, float4(uv + texelSize * float2(-1.0, 0.0), 0, 0));
	float4 G = tex2Dlod(source, float4(uv, 0, 0));
	float4 H = tex2Dlod(source, float4(uv + texelSize * float2(1.0, 0.0), 0, 0));
	float4 I = tex2Dlod(source, float4(uv + texelSize * float2(-0.5, 0.5), 0, 0));
	float4 J = tex2Dlod(source, float4(uv + texelSize * float2(0.5, 0.5), 0, 0));
	float4 K = tex2Dlod(source, float4(uv + texelSize * float2(-1.0, 1.0), 0, 0));
	float4 L = tex2Dlod(source, float4(uv + texelSize * float2(0.0, 1.0), 0, 0));
	float4 M = tex2Dlod(source, float4(uv + texelSize * float2(1.0, 1.0), 0, 0));

	float2 div = (1.0 / 4.0) * float2(0.5, 0.125);

	float4 o = (D + E + I + J) * div.x;
	o += (A + B + G + F) * div.y;
	o += (B + C + H + G) * div.y;
	o += (F + G + L + K) * div.y;
	o += (G + H + M + L) * div.y;

	float3 color = o.xyz;
	color *= coord.z;

	// User controlled clamp to limit crazy high broken spec
	color = min(mBloomClamp * mExposure, color);

	// Thresholding
	float brightness = max(color.r, max(color.g, color.b));
	float softness = clamp(brightness - mBloomThreshold + mBloomThresholdKnee, 0.0, 2.0 * mBloomThresholdKnee);
	softness = (softness * softness) / (4.0 * mBloomThresholdKnee + 1e-4);
	float multiplier = max(brightness - mBloomThreshold, softness) / max(brightness, 1e-4);
	color *= multiplier;

	// Clamp colors to positive once in prefilter. Encode can have a sqrt, and sqrt(-x) == NaN. Up/Downsample passes would then spread the NaN.
	color = max(color, 0);
	return float4(color, 0);
}

float4 BloomBlurVS(
	in float4 Position : POSITION,
	in float2 Texcoord : TEXCOORD,
	out float2 oTexcoord : TEXCOORD0,
	uniform float2 offset
)  : POSITION
{
	oTexcoord = Texcoord + offset * 0.5;
	return Position;
}

float4 BloomBlurHPS(in float2 coord: TEXCOORD0, uniform sampler source, uniform float texelSize) : COLOR
{
	texelSize *= 2.0;
	float2 uv = coord;

	// 9-tap gaussian blur on the downsampled source
	float4 c0 = tex2Dlod(source, float4(uv - float2(texelSize * 4.0, 0.0), 0, 0));
	float4 c1 = tex2Dlod(source, float4(uv - float2(texelSize * 3.0, 0.0), 0, 0));
	float4 c2 = tex2Dlod(source, float4(uv - float2(texelSize * 2.0, 0.0), 0, 0));
	float4 c3 = tex2Dlod(source, float4(uv - float2(texelSize * 1.0, 0.0), 0, 0));
	float4 c4 = tex2Dlod(source, float4(uv                               , 0, 0));
	float4 c5 = tex2Dlod(source, float4(uv + float2(texelSize * 1.0, 0.0), 0, 0));
	float4 c6 = tex2Dlod(source, float4(uv + float2(texelSize * 2.0, 0.0), 0, 0));
	float4 c7 = tex2Dlod(source, float4(uv + float2(texelSize * 3.0, 0.0), 0, 0));
	float4 c8 = tex2Dlod(source, float4(uv + float2(texelSize * 4.0, 0.0), 0, 0));

	float4 color = c0 * 0.01621622 + c1 * 0.05405405 + c2 * 0.12162162 + c3 * 0.19459459
				+ c4 * 0.22702703
				+ c5 * 0.19459459 + c6 * 0.12162162 + c7 * 0.05405405 + c8 * 0.01621622;

	return color;
}

float4 BloomBlurVPS(in float2 coord: TEXCOORD0, uniform sampler source, uniform float texelSize) : COLOR
{
	float2 uv = coord;

	// Optimized bilinear 5-tap gaussian on the same-sized source (9-tap equivalent)
	float4 c0 = tex2Dlod(source, float4(uv - float2(0.0, texelSize * 3.23076923), 0, 0));
	float4 c1 = tex2Dlod(source, float4(uv - float2(0.0, texelSize * 1.38461538), 0, 0));
	float4 c2 = tex2Dlod(source, float4(uv                                      , 0, 0));
	float4 c3 = tex2Dlod(source, float4(uv + float2(0.0, texelSize * 1.38461538), 0, 0));
	float4 c4 = tex2Dlod(source, float4(uv + float2(0.0, texelSize * 3.23076923), 0, 0));

	float4 color = c0 * 0.07027027 + c1 * 0.31621622
				+ c2 * 0.22702703
				+ c3 * 0.31621622 + c4 * 0.07027027;

	return color;
}

float4 BloomUpsample(float2 uv, uniform sampler source, uniform sampler sourceLowMip)
{
	float4 highMip = tex2Dlod(source, float4(uv, 0, 0));
	float4 lowMip = tex2Dlod(sourceLowMip, float4(uv, 0, 0));
	return lerp(highMip, lowMip, mBloomScatter);
}

float4 BloomUpsampleVS(
	in float4 Position : POSITION,
	in float2 Texcoord : TEXCOORD,
	out float2 oTexcoord : TEXCOORD0,
	uniform float2 offset
)  : POSITION
{
	oTexcoord = Texcoord + offset * 0.5;
	return Position;
}

float4 BloomUpsamplePS(
	in float2 coord: TEXCOORD0,
	uniform sampler source,
	uniform sampler sourceLowMip
) : COLOR
{
	return BloomUpsample(coord, source, sourceLowMip);
}

float4 BloomCombineVS(
	in float4 Position : POSITION,
	in float2 Texcoord : TEXCOORD,
	out float2 oTexcoord : TEXCOORD0
)  : POSITION
{
	oTexcoord = Texcoord + ViewportOffset;
	return Position;
}

float4 BloomCombinePS(in float2 coord: TEXCOORD0) : COLOR
{
	float4 bloom = tex2Dlod(BloomMipUpMap1Samp, float4(coord, 0, 0));

#if HDR_STAR_MODE > 0
	float4 star = max(
		tex2Dlod(StreakSamp1st, float4(coord, 0, 0)),
		tex2Dlod(StreakSamp2nd, float4(coord, 0, 0))
	);
#if HDR_STAR_MODE > 2
	star = max(
		star,
		max(
			tex2Dlod(StreakSamp3rd, float4(coord, 0, 0)),
			tex2Dlod(StreakSamp4th, float4(coord, 0, 0))
		)
	);
#endif
	bloom.rgb += star.rgb;
#endif
	return bloom;
}

void BloomPrefilterDownsampleVS(
	in float4 Position : POSITION,
	in float2 Texcoord : TEXCOORD,
	out float2 oTexcoord1 : TEXCOORD0,
	out float2 oTexcoord2 : TEXCOORD1,
	out float2 oTexcoord3 : TEXCOORD2,
	out float2 oTexcoord4 : TEXCOORD3,
	out float4 oPosition : POSITION,
	uniform float2 step)
{
	oPosition = Position;
	oTexcoord1 = Texcoord + step * 0.5;
	oTexcoord2 = oTexcoord1 + float2(step.x, 0);
	oTexcoord3 = oTexcoord1 + float2(step.x, step.y);
	oTexcoord4 = oTexcoord1 + float2(0, step.y);
}

float4 BloomPrefilterDownsamplePS(
	in float2 coord1 : TEXCOORD0,
	in float2 coord2 : TEXCOORD1,
	in float2 coord3 : TEXCOORD2,
	in float2 coord4 : TEXCOORD3,
	uniform sampler source) : COLOR
{
	float4 color = tex2Dlod(source, float4(coord1, 0, 0));
	color += tex2Dlod(source, float4(coord2, 0, 0));
	color += tex2Dlod(source, float4(coord3, 0, 0));
	color += tex2Dlod(source, float4(coord4, 0, 0));
	return (color * 0.25);
}

float4 GhostSourceVS(
	in float4 Position : POSITION,
	in float2 Texcoord : TEXCOORD,
	out float2 oTexcoord : TEXCOORD0
)  : POSITION
{
	oTexcoord = Texcoord + ViewportOffset * 2.0;
	return Position;
}

float4 GhostSourcePS(in float2 coord: TEXCOORD0) : COLOR
{
	return tex2Dlod(BloomMipDownMap2Samp, float4(coord, 0, 0));
}