float time : TIME;

float4x4 matWorld : WORLD;
float4x4 matView : VIEW;
float4x4 matWorldViewProject : WORLDVIEWPROJECTION;

float3 CameraPosition  : POSITION  < string Object = "Camera"; >;
float4 MaterialDiffuse : DIFFUSE  < string Object = "Geometry"; >;

float4x4 waterTransform: CONTROLOBJECT < string Name = "(self)"; string item="Bone";>;

#define TEXTURE_FILTER ANISOTROPIC
#define TEXTURE_MIP_FILTER ANISOTROPIC
#define TEXTURE_ANISOTROPY_LEVEL 16

#define SHADINGMODELID_GLASS 4

#define MIDPOINT_8_BIT (127.0f / 255.0f)
#define MAX_FRACTIONAL_8_BIT (255.0f / 256.0f)
#define TWO_BITS_EXTRACTION_FACTOR (3.0f + MAX_FRACTIONAL_8_BIT)

shared texture Gbuffer2RT: RENDERCOLORTARGET;
shared texture Gbuffer3RT: RENDERCOLORTARGET;
shared texture Gbuffer4RT: RENDERCOLORTARGET;
shared texture Gbuffer5RT: RENDERCOLORTARGET;
shared texture Gbuffer6RT: RENDERCOLORTARGET;
shared texture Gbuffer7RT: RENDERCOLORTARGET;
shared texture Gbuffer8RT: RENDERCOLORTARGET;

#if WAVE_MAP_ENABLE
	texture WaveNormalMap<string ResourceName = WAVE_MAP_FILE;>; 
	sampler WaveNormalMapSamp = sampler_state
	{
		texture = WaveNormalMap;
		MINFILTER = TEXTURE_FILTER; MAGFILTER = TEXTURE_FILTER; MIPFILTER = TEXTURE_MIP_FILTER;
		ADDRESSU = WRAP; ADDRESSV = WRAP;
	};
#endif

#if WAVE_NOISE_MAP_ENABLE
	texture WaveNoiseMap<string ResourceName = WAVE_NOISE_MAP_FILE;>; 
	sampler WaveNoiseMapSamp = sampler_state
	{
		texture = WaveNoiseMap;
		MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
		ADDRESSU = WRAP; ADDRESSV = WRAP;
	};
#endif

#if MASK_MAP_ENABLE
	texture MaskMap<string ResourceName = MASK_MAP_FILE;>; 
	sampler MaskMapSamp = sampler_state
	{
		texture = MaskMap;
		MINFILTER = TEXTURE_FILTER; MAGFILTER = TEXTURE_FILTER; MIPFILTER = TEXTURE_MIP_FILTER;
		ADDRESSU = WRAP; ADDRESSV = WRAP;
	};
#endif

#define INTERACTIVE_SIZE 2048

#define INTERACTIVE_WIDTH  INTERACTIVE_SIZE
#define INTERACTIVE_HEIGHT INTERACTIVE_SIZE

const float2 interactiveSize = float2(23.21363, 23.21363) * 2 * 4;
const float2 interactiveTexelSize = 1.0 / float2(INTERACTIVE_WIDTH, INTERACTIVE_HEIGHT);

texture InteractiveRT: OFFSCREENRENDERTARGET <
    string Description = "Interactive";
    int Width = INTERACTIVE_SIZE;
    int Height = INTERACTIVE_SIZE;
    string Format = "R16F" ;
    float4 ClearColor = { 0, 0, 0, 1 };
    float ClearDepth = 1.0;
    bool AntiAlias = false;
    string DefaultEffect = 
        "self = hide;"
        "water.pmx = hide;"
        "*=interactive_object.fx;";
>;
sampler InteractiveSampler = sampler_state {
    texture = <InteractiveRT>;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
    MipFilter = NONE;
    AddressU  = WRAP;
    AddressV = WRAP;
};

texture DepthBuffer : RenderDepthStencilTarget <
   int Width = INTERACTIVE_WIDTH;
   int Height = INTERACTIVE_HEIGHT;
    string Format = "D24S8";
>;

texture HeightVelocityTex1 : RenderColorTarget
<
   int Width = INTERACTIVE_WIDTH;
   int Height = INTERACTIVE_HEIGHT;
   string Format="G16R16F";
>;
sampler HeightVelocitySampler1 = sampler_state
{
	Texture = <HeightVelocityTex1>;
    Filter = POINT;
    AddressU = CLAMP;
    AddressV = CLAMP;
};
sampler HeightVelocitySampler1_Linear = sampler_state
{
	Texture = <HeightVelocityTex1>;
    Filter = LINEAR;
    AddressU = CLAMP;
    AddressV = CLAMP;
};

texture HeightVelocityTex2 : RenderColorTarget
<
   int Width = INTERACTIVE_WIDTH;
   int Height = INTERACTIVE_HEIGHT;
   string Format="G16R16F";
>;
sampler HeightVelocitySampler2 = sampler_state
{
	Texture = <HeightVelocityTex2>;
    Filter = POINT;
    AddressU = CLAMP;
    AddressV = CLAMP;
};

texture HeightGXTex : RenderColorTarget
<
   int Width = INTERACTIVE_WIDTH;
   int Height = INTERACTIVE_HEIGHT;
   string Format="R16F";
>;
texture HeightGYTex : RenderColorTarget
<
   int Width = INTERACTIVE_WIDTH;
   int Height = INTERACTIVE_HEIGHT;
   string Format="R16F";
>;

sampler HeightGXSampler = sampler_state
{
	Texture = <HeightGXTex>;
    Filter = LINEAR;
    AddressU = CLAMP;
    AddressV = CLAMP;
};
sampler HeightGYSampler = sampler_state
{
	Texture = <HeightGYTex>;
    Filter = LINEAR;
    AddressU = CLAMP;
    AddressV = CLAMP;
};

texture HeightUp1Tex : RenderColorTarget
<
   int Width = INTERACTIVE_WIDTH * 2;
   int Height = INTERACTIVE_HEIGHT * 2;
   string Format="R16F";
>;
sampler HeightUp1Sampler = sampler_state
{
	Texture = <HeightUp1Tex>;
    Filter = LINEAR;
    AddressU = CLAMP;
    AddressV = CLAMP;
};
texture HeightUp2Tex : RenderColorTarget
<
   int Width = INTERACTIVE_WIDTH * 4;
   int Height = INTERACTIVE_HEIGHT * 4;
   string Format="R16F";
>;
sampler HeightUp2Sampler = sampler_state
{
	Texture = <HeightUp2Tex>;
    Filter = LINEAR;
    AddressU = CLAMP;
    AddressV = CLAMP;
};

struct Attributes {
	float4 positionOS : SV_POSITION;
	float2 texcoord0  : TEXCOORD0;
};

struct Varyings {
	float4 positionCS : SV_POSITION;
	float2 texcoord0  : TEXCOORD0;
};

Varyings RippleVS(Attributes input) {
	Varyings output = (Varyings)0;

	output.positionCS = input.positionOS;
	output.texcoord0 = input.texcoord0 + 0.5 * interactiveTexelSize;

	return output;
}

float4 RipplePS1(Varyings input) : COLOR0 {
	float height = 0;
	float velocity = 0;
	if (time <= 0.02) {
		height = 0;
		velocity = 0;
	} else {
		float2 uv = input.texcoord0;
		float2 color = tex2Dlod(HeightVelocitySampler2, float4(uv, 0, 0)).rg;
		height = color.r;
		velocity = color.g;
		float4 heightLRUD = {
			tex2Dlod(HeightVelocitySampler2, float4(uv + float2(-1, 0) * interactiveTexelSize, 0, 0)).r,
			tex2Dlod(HeightVelocitySampler2, float4(uv + float2(+1, 0) * interactiveTexelSize, 0, 0)).r,
			tex2Dlod(HeightVelocitySampler2, float4(uv + float2(0, -1) * interactiveTexelSize, 0, 0)).r,
			tex2Dlod(HeightVelocitySampler2, float4(uv + float2(0, +1) * interactiveTexelSize, 0, 0)).r,
		};

		velocity += ((dot( (heightLRUD - height), float4(1.0, 1.0, 1.0, 1.0))) * 0.4);
		height += velocity;

		float interactive = tex2Dlod(InteractiveSampler, float4(uv, 0, 0)).r;
		height += max(interactive, 0) * 10 * rippleIntensity;
		height *= 0.95;
	}

	return float4(height, velocity, 0, 1);
}

float4 RipplePS2(Varyings input) : COLOR0 {
	return tex2Dlod(HeightVelocitySampler1, float4(input.texcoord0, 0, 0));
}

const float c_BlurRadius = 0.25;
const float u_BlurWeights[8] = {
	0.0920246,
	0.0902024,
	0.0849494,
	0.0768654,
	0.0668236,
	0.0558158,
	0.0447932,
	0.0345379
};

Varyings BlurXVS(Attributes input) { 
    Varyings output = (Varyings)0;

	output.positionCS = input.positionOS;
	output.texcoord0 = input.texcoord0 + 0.5 * interactiveTexelSize;

	return output;
}

float4 BlurXPS(Varyings input) : COLOR0 {
	float2 uv = input.texcoord0;
	float radius = c_BlurRadius * interactiveTexelSize.x;

	float w[8] = u_BlurWeights;
	
	float g = 0;
	g += w[0] * tex2Dlod(HeightVelocitySampler1_Linear, float4(uv, 0, 0)).r;
	g += w[1] * (tex2Dlod(HeightVelocitySampler1_Linear, float4(uv + float2(radius * 1, 0), 0, 0)).r + tex2Dlod(HeightVelocitySampler1_Linear, float4(uv - float2(radius * 1, 0), 0, 0)).r);
	g += w[2] * (tex2Dlod(HeightVelocitySampler1_Linear, float4(uv + float2(radius * 2, 0), 0, 0)).r + tex2Dlod(HeightVelocitySampler1_Linear, float4(uv - float2(radius * 2, 0), 0, 0)).r);
	g += w[3] * (tex2Dlod(HeightVelocitySampler1_Linear, float4(uv + float2(radius * 3, 0), 0, 0)).r + tex2Dlod(HeightVelocitySampler1_Linear, float4(uv - float2(radius * 3, 0), 0, 0)).r);
	g += w[4] * (tex2Dlod(HeightVelocitySampler1_Linear, float4(uv + float2(radius * 4, 0), 0, 0)).r + tex2Dlod(HeightVelocitySampler1_Linear, float4(uv - float2(radius * 4, 0), 0, 0)).r);
	g += w[5] * (tex2Dlod(HeightVelocitySampler1_Linear, float4(uv + float2(radius * 5, 0), 0, 0)).r + tex2Dlod(HeightVelocitySampler1_Linear, float4(uv - float2(radius * 5, 0), 0, 0)).r);
	g += w[6] * (tex2Dlod(HeightVelocitySampler1_Linear, float4(uv + float2(radius * 6, 0), 0, 0)).r + tex2Dlod(HeightVelocitySampler1_Linear, float4(uv - float2(radius * 6, 0), 0, 0)).r);
	g += w[7] * (tex2Dlod(HeightVelocitySampler1_Linear, float4(uv + float2(radius * 7, 0), 0, 0)).r + tex2Dlod(HeightVelocitySampler1_Linear, float4(uv - float2(radius * 7, 0), 0, 0)).r);
	
    return float4(g.xxx, 1);
}

Varyings BlurYVS(Attributes input) { 
	Varyings output = (Varyings)0;

	output.positionCS = input.positionOS;
	output.texcoord0 = input.texcoord0 + 0.5 * interactiveTexelSize;

	return output;
}

float4 BlurYPS(Varyings input) : COLOR0 {
	float2 uv = input.texcoord0;
	float radius = c_BlurRadius * interactiveTexelSize.y;

	float w[8] = u_BlurWeights;

	float g = 0;
	g += w[0] * tex2Dlod(HeightGXSampler, float4(uv, 0, 0)).r;
	g += w[1] * (tex2Dlod(HeightGXSampler, float4(uv + float2(0, radius * 1), 0, 0)).r + tex2Dlod(HeightGXSampler, float4(uv - float2(0, radius * 1), 0, 0)).r);
	g += w[2] * (tex2Dlod(HeightGXSampler, float4(uv + float2(0, radius * 2), 0, 0)).r + tex2Dlod(HeightGXSampler, float4(uv - float2(0, radius * 2), 0, 0)).r);
	g += w[3] * (tex2Dlod(HeightGXSampler, float4(uv + float2(0, radius * 3), 0, 0)).r + tex2Dlod(HeightGXSampler, float4(uv - float2(0, radius * 3), 0, 0)).r);
	g += w[4] * (tex2Dlod(HeightGXSampler, float4(uv + float2(0, radius * 4), 0, 0)).r + tex2Dlod(HeightGXSampler, float4(uv - float2(0, radius * 4), 0, 0)).r);
	g += w[5] * (tex2Dlod(HeightGXSampler, float4(uv + float2(0, radius * 5), 0, 0)).r + tex2Dlod(HeightGXSampler, float4(uv - float2(0, radius * 5), 0, 0)).r);
	g += w[6] * (tex2Dlod(HeightGXSampler, float4(uv + float2(0, radius * 6), 0, 0)).r + tex2Dlod(HeightGXSampler, float4(uv - float2(0, radius * 6), 0, 0)).r);
	g += w[7] * (tex2Dlod(HeightGXSampler, float4(uv + float2(0, radius * 7), 0, 0)).r + tex2Dlod(HeightGXSampler, float4(uv - float2(0, radius * 7), 0, 0)).r);
	
    return float4(g.xxx, 1);
}

Varyings UpSampleVS(Attributes input, uniform float scale) {
	Varyings output = (Varyings)0;

	output.positionCS = input.positionOS;
	output.texcoord0 = input.texcoord0 + interactiveTexelSize / scale;

	return output;
}

float4 UpSamplePS(Varyings input, uniform sampler source) : COLOR {
	return tex2Dlod(source, float4(input.texcoord0, 0, 0));
}

struct MaterialParam
{
	float3 normal;
	float3 albedo;
	float3 specular;
	float3 emissive;
	float emissiveIntensity;
	float smoothness;
	float alpha;
	float visibility;
	float customDataA;
	float3 customDataB;
	int lightModel;
};

struct GbufferParam
{
	float4 buffer1 : COLOR0;
	float4 buffer2 : COLOR1;
	float4 buffer3 : COLOR2;
	float4 buffer4 : COLOR3;
};

float3 EncodeNormal(float3 normal)
{
	float p = sqrt(-normal.z * 8 + 8);
	float2 enc = normal.xy / p + 0.5f;
	float2 enc255 = enc * 255;
	float2 residual = floor(frac(enc255) * 16);
	return float3(floor(enc255), residual.x * 16 + residual.y) / 255;
}

float3 rgb2ycbcr(float3 col)
{
	float3 encode;
	encode.x = dot(float3(0.299, 0.587, 0.114),   col.rgb);
	encode.y = dot(float3(-0.1687, -0.3312, 0.5), col.rgb);
	encode.z = dot(float3(0.5, -0.4186, -0.0813), col.rgb);
	return float3(encode.x, encode.y * MIDPOINT_8_BIT + MIDPOINT_8_BIT, encode.z * MIDPOINT_8_BIT + MIDPOINT_8_BIT);
}

float3 ComputeTangentBinormalNormal(float3 N, float3 P, float2 coord, float3 tangentNormal)
{
	float3 dp1 = ddx(P);
	float3 dp2 = ddy(P);
	float2 duv1 = ddx(coord);
	float2 duv2 = ddy(coord);

	float3x3 M = float3x3(dp1, dp2, N);
	float2x3 I = float2x3(cross(M[1], M[2]), cross(M[2], M[0]));
	float3 T = mul(float2(duv1.x, duv2.x), I);
	float3 B = mul(float2(duv1.y, duv2.y), I);

	float scaleT = 1.0f / (dot(T, T) + 1e-6);
	float scaleB = 1.0f / (dot(B, B) + 1e-6);

	float3x3 tbnTransform;
	tbnTransform[0] = normalize(T * scaleT);
	tbnTransform[1] = normalize(B * scaleB);
	tbnTransform[2] = N;

	return normalize(mul(tangentNormal, tbnTransform));
}

float luminance(float3 rgb)
{
	return dot(rgb, float3(0.2126f, 0.7152f, 0.0722f));
}

GbufferParam EncodeGbuffer(MaterialParam material, float linearDepth)
{
	GbufferParam gbuffer;
	gbuffer.buffer1.xyz = material.albedo;
	gbuffer.buffer1.w = material.smoothness;

	material.normal = mul(material.normal, (float3x3)matView);
	material.normal = normalize(material.normal);

	gbuffer.buffer2.xyz = EncodeNormal(material.normal);
	gbuffer.buffer2.w = material.customDataA;

	gbuffer.buffer3.xyz = material.specular;
	gbuffer.buffer3.w = 0;

	gbuffer.buffer4 = float4(linearDepth, material.emissiveIntensity, material.visibility, material.lightModel);
	gbuffer.buffer4.w += material.alpha * MAX_FRACTIONAL_8_BIT;

	return gbuffer;
}

float noise(float2 p)
{
	return tex2Dlod(WaveNoiseMapSamp, float4(p / 256.0, 0, 0)).x;
}

float fbm(float2 p) 
{
	float2x2 m2 = float2x2(1.6,-1.2,1.2,1.6);
	float f = 0;
	f += 0.5000 * noise( p ); p = mul(m2, p);
	f += 0.2500 * noise( p ); p = mul(m2, p);
	f += 0.1666 * noise( p );
	return f;
}

float GetWaterHeight(float2 p)
{
	float2 shift1 = float2(0.32, 0.24) * time;
	float2 shift2 = float2(0.38,-0.26) * time;
	
	float2 p2 = p * waveLoopsHigh;

	float wave = 0;
	wave += sin(dot(p2, 0.622) + shift2.x * 4.269);
	wave *= fbm(p);
	wave *= waveHeightHigh;

	p *= waveLoopsLow;

	float f = 0;
	float s = 0.5;
	float amp = 1.0;
	float2x2 m = float2x2(0.72, -1.60,  1.60, 0.72);

	for (int i = 0; i < 9; i++)
	{
		p = mul(m, p) * 0.947; 
		f -= amp * abs(sin((noise(p + shift1 * s) - 0.5) * 2.0)); 
		amp = amp * 0.59;
		s *= -1.329;
	}

	return wave + f * waveHeightLow;
}

float4 GenWaterNormal(float2 coord)
{
	float2 dif = float2(0, 0.01);

	float h0 = GetWaterHeight(coord * 15);
	float h1 = GetWaterHeight(coord * 15 - dif);
	float h2 = GetWaterHeight(coord * 15 + dif);
	float h3 = GetWaterHeight(coord * 15 - dif.yx);
	float h4 = GetWaterHeight(coord * 15 + dif.yx);

	float3 bumpNormal = normalize(float3(h3 - h4, h1 - h2, 0.15));
	return float4(bumpNormal, h0);
}

float2 GetParalaxOffset(sampler source, float2 coord, float3 V)
{
	const float gradientScale = 0.5 * 0.01;
	const float heightScale   = 0.5 * 0.01;

	float4 height = GenWaterNormal(coord);
	height.xy = gradientScale * height.xy;
	height.w  = heightScale   * height.w;

	float2 paralaxOffset = V.xy * height.w + height.xy;
	return paralaxOffset;
}

float3 GetWaveNormal(float2 coord, float3 N, float3 V, float3 P, float3 R)
{
	float3 bumpNormal = float3(0, 0, 1);

#if WAVE_MAP_ENABLE
	float4 wave = coord.xyxy * waveMapLoopNumLow.xyxy;
	wave *= float4(1, 1, 2, 2);

	float2 paralaxOffset = GetParalaxOffset(WaveNormalMapSamp, wave.xy, V);

	bumpNormal = GenWaterNormal(wave.xy + paralaxOffset.xy).xyz;
	bumpNormal.xy *= waveMapScaleLow;
#endif
	bumpNormal.xy += R.xy;

	return ComputeTangentBinormalNormal(N, P, coord, bumpNormal);
}

struct MaterialAttributes {
	float4 positionOS : SV_POSITION;
	float3 normalOS   : NORMAL;
	float2 texcoord0  : TEXCOORD0;
};

struct MaterialVaryings {
	float4 positionCS : SV_POSITION;
	float2 texcoord   : TEXCOORD0;
	float3 normalWS   : TEXCOORD1;
	float3 positionWS : TEXCOORD2;
	float4 viewDirectionWSAndDepth : TEXCOORD3;
};

MaterialVaryings MaterialVS(MaterialAttributes input) {
	float4 positionCS = mul(input.positionOS, matWorldViewProject);
	float2 texcoord = input.texcoord0;
	float3 normalWS = mul(input.normalOS, (float3x3)(matWorld));
	float3 positionWS = mul(input.positionOS, matWorld).xyz;
	float3 viewDirectionWS = CameraPosition - positionWS;

	MaterialVaryings output = (MaterialVaryings)0;
	output.positionCS = positionCS;
	output.texcoord = texcoord;
	output.normalWS = normalWS;
	output.positionWS = positionWS;
	output.viewDirectionWSAndDepth = float4(viewDirectionWS, positionCS.w);

	return output;
}

GbufferParam MaterialPS(MaterialVaryings input)
{
	float fAlpha = alpha;

	#if MASK_MAP_ENABLE
	{
		float mask = tex2D(MaskMapSamp, input.texcoord).r;
		fAlpha *= mask;
	}
	#endif

	clip(fAlpha - 0.01);
	float3 positionWS = input.positionWS;
	float rippleHeight = 0;
	{
		float3x3 R = (float3x3)waterTransform;
		float3 T = waterTransform[3].xyz;

		float3x3 RInverse = transpose(R);
		float4x4 inTransform = float4x4(
			RInverse[0], 0,
			RInverse[1], 0,
			RInverse[2], 0,
			0, 0, 0, 1
		);

		float4 positionOS = mul(float4(positionWS - T, 1), inTransform);
		float2 uv = (positionOS.xz * 2.0 / interactiveSize * 0.5 + 0.5);
		uv.y = 1.0 - uv.y;
		if (all(floor(uv.xy) == 0)) {
			rippleHeight = tex2Dlod(HeightUp2Sampler, float4(uv.xy, 0, 0)).r;
		}
	}


	float height_dx = ddx(rippleHeight) * rippleNormalIntensity;
    float height_dy = ddy(rippleHeight) * rippleNormalIntensity;
	float3 rippleNormal = normalize(float3(height_dx, height_dy, 1.0));

	MaterialParam material = (MaterialParam)0;
	material.albedo = lerp(albedo, 0, metallic);
	material.normal = GetWaveNormal(input.texcoord, input.normalWS, normalize(input.viewDirectionWSAndDepth.xyz), positionWS, rippleNormal);
	material.smoothness = smoothness;
	material.specular = lerp(0.08, albedo, metallic);
	material.customDataA = 0;
	material.customDataB = 0;
	material.emissive = 0.0;
	material.emissiveIntensity = 0.0;
	material.visibility = 1.0;
	material.lightModel = 0;
	material.alpha = fAlpha;

	return EncodeGbuffer(material, input.viewDirectionWSAndDepth.w);
}

#define OBJECT_TEC(name, mmdpass) \
	technique name < string MMDPass = mmdpass; \
	string Script = \
		"RenderDepthStencilTarget=DepthBuffer;" \
        "RenderColorTarget0=HeightVelocityTex1;" \
	    "Pass=RippleHeight1;" \
		"RenderColorTarget0=HeightVelocityTex2;" \
	    "Pass=RippleHeight2;" \
		"RenderColorTarget0=HeightGXTex;" \
	    "Pass=BlurX;" \
        "RenderColorTarget0=HeightGYTex;" \
	    "Pass=BlurY;" \
		"RenderColorTarget0=HeightUp1Tex;" \
	    "Pass=UpSample1;" \
		"RenderColorTarget0=HeightUp2Tex;" \
	    "Pass=UpSample2;" \
		"RenderDepthStencilTarget=;" \
		"RenderColorTarget0=Gbuffer5RT;" \
		"RenderColorTarget1=Gbuffer6RT;" \
		"RenderColorTarget2=Gbuffer7RT;" \
		"RenderColorTarget3=Gbuffer8RT;" \
		"Pass=DrawObject;"\
	;> { \
		pass RippleHeight1 < string Script = "Draw=Buffer;";> { \
			ALPHABLENDENABLE = FALSE; ALPHATESTENABLE=FALSE; \
			ZENABLE = FALSE; ZWRITEENABLE = FALSE; \
			VertexShader = compile vs_3_0 RippleVS(); \
			PixelShader = compile ps_3_0 RipplePS1(); \
		} \
		pass RippleHeight2 < string Script = "Draw=Buffer;";> { \
			ALPHABLENDENABLE = FALSE; ALPHATESTENABLE=FALSE; \
			ZENABLE = FALSE; ZWRITEENABLE = FALSE; \
			VertexShader = compile vs_3_0 RippleVS(); \
			PixelShader = compile ps_3_0 RipplePS2(); \
		} \
		pass BlurX < string Script= "Draw=Buffer;"; > { \
			AlphaBlendEnable = FALSE; \
			VertexShader = compile vs_3_0 BlurXVS(); \
			PixelShader  = compile ps_3_0 BlurXPS(); \
		} \
		pass BlurY < string Script= "Draw=Buffer;"; > { \
			AlphaBlendEnable = FALSE; \
			VertexShader = compile vs_3_0 BlurYVS(); \
			PixelShader  = compile ps_3_0 BlurYPS(); \
		} \
		pass UpSample1 < string Script= "Draw=Buffer;"; > { \
			ALPHABLENDENABLE = FALSE; ALPHATESTENABLE=FALSE; \
			ZENABLE = FALSE; ZWRITEENABLE = FALSE; \
			VertexShader = compile vs_3_0 UpSampleVS(2.0); \
			PixelShader  = compile ps_3_0 UpSamplePS(HeightGYSampler); \
		} \
		pass UpSample2 < string Script= "Draw=Buffer;"; > { \
			ALPHABLENDENABLE = FALSE; ALPHATESTENABLE=FALSE; \
			ZENABLE = FALSE; ZWRITEENABLE = FALSE; \
			VertexShader = compile vs_3_0 UpSampleVS(4.0); \
			PixelShader  = compile ps_3_0 UpSamplePS(HeightUp1Sampler); \
		} \
		pass DrawObject { \
			AlphaTestEnable = false; AlphaBlendEnable = false; \
			VertexShader = compile vs_3_0 MaterialVS(); \
			PixelShader  = compile ps_3_0 MaterialPS(); \
		} \
	}

OBJECT_TEC(MainTec0, "object")
