float2 ViewportSize : VIEWPORTPIXELSIZE;
static float2 ViewportOffset  = 0.5 / ViewportSize;
static float2 ViewportOffset2 = 1.0 / ViewportSize;

static const float mBloomIntensityMin = 0.0;
static const float mBloomIntensityMax = 20.0;
static const float mBloomClamp = 3.0;
static const float mBloomMaxDepth = 500;

float mBloomThresholdP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Threshold";>;
float mBloomIntensityP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Intensity+";>;
float mBloomIntensityM : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Intensity-";>;
float mBloomScatterP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Scatter+";>;
float mBloomScatterM : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Scatter-";>;
float mBloomDepthM : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Depth-";>;
float mBloomNearM : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Near-";>;
float mBloomTintRP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "TintR+";>;
float mBloomTintGP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "TintG+";>;
float mBloomTintBP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "TintB+";>;
float mBloomHueP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Hue+";>;
float mBloomHueM : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Hue-";>;
float mBloomSaturationP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Saturation+";>;
float mBloomSaturationM : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Saturation-";>;
float mBloomDirtIntensityP : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Dirt+";>;
float mBloomDirtIntensityM : CONTROLOBJECT<string name="bloom_controller.pmx"; string item = "Dirt-";>;

static float mBloomThreshold = (1.0 - mBloomThresholdP) / (mBloomThresholdP + 1e-5);
static float mBloomThresholdKnee = mBloomThreshold * 0.5;
static float mBloomIntensity = lerp(lerp(1.0, mBloomIntensityMax, mBloomIntensityP), mBloomIntensityMin, mBloomIntensityM);
static float mBloomScatter = lerp(lerp(0.7, 0.95, mBloomScatterP), 0.05, mBloomScatterM);
static float mBloomHue = lerp(lerp(0.5, 1, mBloomHueP), 0, mBloomHueM);
static float mBloomSaturation = lerp(lerp(1, 2, mBloomSaturationP), 0, mBloomSaturationM);
static float mBloomDirtIntensity = lerp(lerp(dirtIntensityParams.x, dirtIntensityParams.z, mBloomDirtIntensityP), dirtIntensityParams.y, mBloomDirtIntensityM);

texture ScnMap : RENDERCOLORTARGET <
	float2 ViewportRatio = {1.0,1.0};
	bool AntiAlias = false;
	string Format = "A16B16G16R16F";
>;
sampler ScnSamp = sampler_state {
	texture = <ScnMap>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU  = CLAMP; AddressV = CLAMP;
};
texture2D DepthBuffer : RENDERDEPTHSTENCILTARGET<
	float2 ViewportRatio = {1.0,1.0};
	string Format = "D24S8";
>;

