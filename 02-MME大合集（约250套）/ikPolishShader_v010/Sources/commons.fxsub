
// 共通処理、カテゴリ分けから漏れた汎用処理



////////////////////////////////////////////////////////////////////////////////////////////////
// マクロ

#define TO_STRING(str) #str


////////////////////////////////////////////////////////////////////////////////////////////////
// ガンマ補正
const float gamma = 2.2333;
const float epsilon = 1.0e-6;
inline float3 Degamma(float3 col) { return pow(max(col,epsilon), gamma); }
inline float3 Gamma(float3 col) { return pow(max(col,epsilon), 1.0/gamma); }
inline float4 Degamma4(float4 col) { return float4(Degamma(col.rgb), col.a); }
inline float4 Gamma4(float4 col) { return float4(Gamma(col.rgb), col.a); }
inline float rgb2gray(float3 rgb)
{
	return dot(float3(0.299, 0.587, 0.114), max(rgb,0));
}


// 法線と深度からワールド座標を再構築する
static float4x4 matTex2Proj = {
		 2, 0, 0, 0,
		 0,-2, 0, 0,
		-1, 1, matP._33, 1,
		 0, 0, matP._43, 0
	};
static float4x4 matTex2World = mul(matTex2Proj, matInvVP);

inline void GetWND(float2 Tex, out float3 WPos, out float3 N, out float Depth)
{
	float4 ND = tex2D( NormalSamp, Tex);
	N = normalize(ND.xyz);
	Depth = ND.w;

	float4 ppos = float4(float3(Tex.xy, 1) * Depth, 1);
	float4 wpos = mul(ppos, matTex2World);
	WPos = wpos.xyz / wpos.w;
}

inline void GetWNDLod(float2 Tex, out float3 WPos, out float3 N, out float Depth)
{
	float4 ND = tex2Dlod( NormalSamp, float4(Tex,0,0));
	N = normalize(ND.xyz);
	Depth = ND.w;

	float4 ppos = float4(float3(Tex.xy, 1) * Depth, 1);
	float4 wpos = mul(ppos, matTex2World);
	WPos = wpos.xyz / wpos.w;
}

// 座標だけ取得する
inline float3 GetWPos(float2 Tex)
{
	float4 ND = tex2D( NormalSamp, Tex);
	float4 ppos = float4(float3(Tex.xy, 1) * ND.w, 1);
	float4 wpos = mul(ppos, matTex2World);
	return wpos.xyz / wpos.w;
}

// 深度だけを取得する
inline float GetDepth(float2 Tex)
{
	return tex2Dlod( NormalSamp, float4(Tex,0,0)).w;
}

// 法線だけを取得する
inline float3 GetNormal(float2 Tex)
{
	return normalize(tex2Dlod( NormalSamp, float4(Tex,0,0)).xyz);
}

// ブラーの強さを計算する
inline float CalcBlurWeight(float d0, float d1, float r2, float depthRate)
{
	float d = (d0 - d1) * depthRate;
	return exp(r2 - d*d);
}

////////////////////////////////////////////////////////////////////////////////////////////////
//

struct VS_OUTPUT {
	float4 Pos			: POSITION;
	float4 Tex			: TEXCOORD0;
};

VS_OUTPUT VS_Common( float4 Pos : POSITION, float2 Tex : TEXCOORD0 )
{
	VS_OUTPUT Out = (VS_OUTPUT)0; 
	Out.Pos = Pos;
	Out.Tex.xy = Tex + ViewportOffset;
	Out.Tex.zw = Tex + ViewportOffset2;
	return Out;
}
